{
  "name": "mentoryab-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "import:group_members": "tsx scripts/import_group_members.ts",
    "import:group_member_snapshot": "tsx scripts/import_group_member_snapshot.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "node-telegram-bot-api": "^0.66.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/node-telegram-bot-api": "^0.64.15",
    "prisma": "^6.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "vitest": "^1.6.1"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
