# Production .env example for use with docker-compose.prod.yml.
# Copy this file to .env on the VPS and do not commit the real values.

PORT=3000
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
ADMIN_TELEGRAM_IDS=123456789
# Optional: numeric chat ID of the group where unmatched mentee requests get
# posted. Add the bot to the group and run /groupid there.
MENTORS_GROUP_CHAT_ID=
DATABASE_URL=postgresql://mentoryab:strongpassword@postgres:5432/mentoryab
POSTGRES_USER=mentoryab
POSTGRES_PASSWORD=strongpassword
