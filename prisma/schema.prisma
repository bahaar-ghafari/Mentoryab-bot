generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int      @id @default(autoincrement())
  telegramId       String   @unique
  firstName        String?
  lastName         String?
  username         String?
  role             Role     @default(MENTEE)
  language         String   @default("en")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  mentorProfile    MentorProfile?
  menteeProfile    MenteeProfile?
}

enum Role {
  MENTOR
  MENTEE
  ADMIN
}

model Skill {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  title     String?  @default("General")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MentorProfile {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique
  user            User     @relation(fields: [userId], references: [id])
  name            String
  title           String?
  skills          String[]
  experienceYears Int
  country         String?
  city            String?
  location        String?
  availability    Boolean  @default(true)
  contactMethods  String[] @default([])
  telegramContact String?  @unique
  phoneContact    String?  @unique
  emailContact    String?  @unique
  language        String   @default("en")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  mentorshipRequests MentorshipRequest[]
}

model MenteeProfile {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique
  user            User     @relation(fields: [userId], references: [id])
  name            String
  goals           String?
  skillsNeeded    String[]
  experienceYears Int?
  country         String?
  city            String?
  location        String?
  language        String   @default("en")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  mentorshipRequests MentorshipRequest[]
}

enum RequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model MentorshipRequest {
  id              Int            @id @default(autoincrement())
  mentorProfile   MentorProfile  @relation(fields: [mentorProfileId], references: [id])
  mentorProfileId Int
  menteeProfile   MenteeProfile  @relation(fields: [menteeProfileId], references: [id])
  menteeProfileId Int
  status          RequestStatus  @default(PENDING)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}
