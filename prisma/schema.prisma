generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int      @id @default(autoincrement())
  telegramId       String   @unique
  firstName        String?
  lastName         String?
  username         String?
  role             Role     @default(MENTEE)
  language         String   @default("en")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  mentorProfile    MentorProfile?
  menteeProfile    MenteeProfile?
}

enum Role {
  MENTOR
  MENTEE
  ADMIN
}

model Skill {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  title     String?  @default("General")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MentorProfile {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique
  user            User     @relation(fields: [userId], references: [id])
  name            String
  title           String?
  skills          String[]
  experienceYears Int
  country         String?
  city            String?
  location        String?
  availability    Boolean  @default(true)
  busyUntil       DateTime?
  contactMethods  String[] @default([])
  telegramContact String?  @unique
  phoneContact    String?  @unique
  emailContact    String?  @unique
  language        String   @default("en")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  mentorshipRequests MentorshipRequest[]
}

model MenteeProfile {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique
  user            User     @relation(fields: [userId], references: [id])
  name            String
  goals           String?
  skillsNeeded    String[]
  experienceYears Int?
  country         String?
  city            String?
  location        String?
  language        String   @default("en")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  mentorshipRequests MentorshipRequest[]
  mentorSearchRequests MentorSearchRequest[]
}

enum RequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model MentorshipRequest {
  id              Int            @id @default(autoincrement())
  mentorProfile   MentorProfile  @relation(fields: [mentorProfileId], references: [id], onDelete: Cascade)
  mentorProfileId Int
  menteeProfile   MenteeProfile  @relation(fields: [menteeProfileId], references: [id], onDelete: Cascade)
  menteeProfileId Int
  status          RequestStatus  @default(PENDING)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

model ProfileAuditLog {
  id         Int         @id @default(autoincrement())
  telegramId String
  role       Role
  action     AuditAction
  actor      String
  snapshot   Json
  createdAt  DateTime    @default(now())
}

// A mentee's "couldn't auto-match" request posted to the mentors group. Stays
// unclaimed until a mentor taps the claim button; re-posted weekly until then.
model MentorSearchRequest {
  id                  Int           @id @default(autoincrement())
  menteeProfile       MenteeProfile @relation(fields: [menteeProfileId], references: [id], onDelete: Cascade)
  menteeProfileId     Int
  explanation         String
  claimed             Boolean       @default(false)
  claimedByTelegramId String?
  lastPostedAt        DateTime      @default(now())
  createdAt           DateTime      @default(now())
}
