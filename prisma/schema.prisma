generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int      @id @default(autoincrement())
  telegramId       String   @unique
  firstName        String?
  lastName         String?
  username         String?
  role             Role     @default(MENTEE)
  language         String   @default("en")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  mentorProfile    MentorProfile?
  menteeProfile    MenteeProfile?
}

enum Role {
  MENTOR
  MENTEE
  ADMIN
}

model Skill {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  title     String?  @default("General")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MentorProfile {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique
  user            User     @relation(fields: [userId], references: [id])
  name            String
  title           String?
  skills          String[]
  experienceYears Int
  country         String?
  location        String?
  availability    Boolean  @default(true)
  // New mentor signups need admin approval before showing up in mentee
  // searches. Never reset by profile edits — only set once, at creation.
  approved        Boolean  @default(false)
  busyUntil       DateTime?
  contactMethods  String[] @default([])
  telegramContact String?  @unique
  phoneContact    String?  @unique
  emailContact    String?  @unique
  language        String   @default("en")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  mentorshipRequests MentorshipRequest[]
  feedbackReceived   MentorFeedback[]
}

model MenteeProfile {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique
  user            User     @relation(fields: [userId], references: [id])
  name            String
  goals           String?
  skillsNeeded    String[]
  experienceYears Int?
  country         String?
  location        String?
  language        String   @default("en")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  mentorshipRequests MentorshipRequest[]
  mentorSearchRequests MentorSearchRequest[]
  feedbackGiven   MentorFeedback[]
}

enum RequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model MentorshipRequest {
  id              Int            @id @default(autoincrement())
  mentorProfile   MentorProfile  @relation(fields: [mentorProfileId], references: [id], onDelete: Cascade)
  mentorProfileId Int
  menteeProfile   MenteeProfile  @relation(fields: [menteeProfileId], references: [id], onDelete: Cascade)
  menteeProfileId Int
  status          RequestStatus  @default(PENDING)
  // Set once we've asked the mentee to rate this mentorship, so the daily
  // feedback-prompt scheduler doesn't ask again.
  feedbackRequestedAt DateTime?
  feedback        MentorFeedback?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

// A mentee's rating/comment for one accepted mentorship. The score always
// counts toward the mentor's public average; the comment only becomes
// visible on the mentor's profile once BOTH the mentor and an admin have
// approved it (either can silently keep it hidden by leaving their flag
// false/null — no separate "rejected" state needed for that).
model MentorFeedback {
  id                  Int      @id @default(autoincrement())
  mentorshipRequest   MentorshipRequest @relation(fields: [mentorshipRequestId], references: [id], onDelete: Cascade)
  mentorshipRequestId Int      @unique
  mentorProfile       MentorProfile @relation(fields: [mentorProfileId], references: [id], onDelete: Cascade)
  mentorProfileId     Int
  menteeProfile       MenteeProfile @relation(fields: [menteeProfileId], references: [id], onDelete: Cascade)
  menteeProfileId     Int
  score               Int
  comment             String?
  // null = not yet reviewed, true = approved, false = rejected
  mentorApproved      Boolean?
  adminApproved       Boolean?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

model ProfileAuditLog {
  id         Int         @id @default(autoincrement())
  telegramId String
  role       Role
  action     AuditAction
  actor      String
  snapshot   Json
  createdAt  DateTime    @default(now())
}

// A mentee's "couldn't auto-match" request posted to the mentors group. Stays
// unclaimed until a mentor taps the claim button; re-posted weekly until then.
model MentorSearchRequest {
  id                  Int           @id @default(autoincrement())
  menteeProfile       MenteeProfile @relation(fields: [menteeProfileId], references: [id], onDelete: Cascade)
  menteeProfileId     Int
  explanation         String
  claimed             Boolean       @default(false)
  claimedByTelegramId String?
  lastPostedAt        DateTime      @default(now())
  createdAt           DateTime      @default(now())
}
